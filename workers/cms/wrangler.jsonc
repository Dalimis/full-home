{
  // fullhome-cms：投資人專區 CMS（後台 /admin/、admin API、公開 API、檔案下載）
  // 注意：用 wrangler deploy 部署時，這份設定會「覆蓋」Dashboard 上的路由、變數與繫結。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fullhome-cms",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",

  // 只走自訂網域路由；workers.dev 與預覽網址會繞過 Access，必須關閉
  "workers_dev": false,
  "preview_urls": false,

  "routes": [
    { "pattern": "www.full-home.com.tw/admin*", "zone_name": "full-home.com.tw" },
    { "pattern": "www.full-home.com.tw/api/admin*", "zone_name": "full-home.com.tw" },
    { "pattern": "www.full-home.com.tw/api/public/investors*", "zone_name": "full-home.com.tw" },
    { "pattern": "www.full-home.com.tw/files/*", "zone_name": "full-home.com.tw" },
    // 首頁經過 Worker，把後台編輯的內容套進 HTML；失敗時直接回傳 Pages 原始頁面。
    // 必須用 /*：沒有萬用字元的路由不會匹配帶查詢字串的網址（?fbclid=、?utm_source=、編輯器的 ?cms-edit=1）。
    // 其他路徑由 Worker 原封不動轉給 Pages；/api/contact 有更精確的路由，仍由 fullhome-contact 處理。
    { "pattern": "www.full-home.com.tw/*", "zone_name": "full-home.com.tw" },
    // 後台上傳的頁面圖片（R2 media/ 前綴）
    { "pattern": "www.full-home.com.tw/media/*", "zone_name": "full-home.com.tw" }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fullhome-cms-db",
      "database_id": "afc512c2-803f-4f8c-9701-d9d76b96f73a"
    }
  ],

  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "fullhome-files" },
    // 備份專用 bucket（需先在 Dashboard 建立）：d1/ 資料庫快照、files/ 檔案副本、status/ 最近一次結果
    { "binding": "BACKUPS", "bucket_name": "fullhome-backups" }
  ],

  // 每天 18:00 UTC（台灣 02:00）：備份 + 清理過期的聯絡表單紀錄
  "triggers": {
    "crons": ["0 18 * * *"]
  },

  // 非機密設定（AUD 與 team domain 都會出現在公開的登入轉址網址中）
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://da-li.cloudflareaccess.com",
    "ACCESS_AUD": "daeb672686dea5daf2b819f477ccf8f8dee84281da44b4ceb9ff187eb0a29d7c",
    // 系統管理員：永遠擁有全部權限（含權限管理），不受後台設定影響，避免被鎖在外面
    "SUPER_ADMINS": "dennis.chen@da-li.com.tw,mis@da-li.com.tw",
    // 聯絡表單紀錄保存天數（個資），超過自動刪除
    "CONTACT_RETENTION_DAYS": "365"
  },

  "observability": {
    "enabled": true
  }
}
